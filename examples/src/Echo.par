module Echo

import {
  @core/Bytes
  @basic/Console
  @basic/Os
}

def Main: ! = chan exit {
  let reader = Os.Stdin
  let writer = Os.Stdout

  catch e: Os.Error => {
    let console = Console.Open
    console.print(e)
    exit!
  }

  reader.begin.read.try.case {
    .end! => {
      writer.close.try
      exit!
    }
    .chunk(bytes) => {
      writer.write(bytes).try
      reader.loop
    }
  }
}
