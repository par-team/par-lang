module MiniGrep

import {
  @core/Bool
  @core/List
  @core/Nat
  @core/String
  @core/Stream
  @core/Try
  @basic/Console
  @basic/Os
}

def Main: ! = chan exit {
  let console = Console.Open

  catch ! => {
    console.print("Failed to read input.")
    exit!
  }

  console.print("Welcome to Mini Grep!")
  console.prompt("Directory: ")[try path]
  console.prompt("Needle: ")[try needle]

  catch e => {
    console.print(e)
    exit!
  }

  let try paths = path->Os.Path->TraverseDirectory
  paths.begin.case {
    .end! => {}
    .item(path) => {
      catch e => {
        console.print("")
        console.print(e)
        paths.loop
      }
      let try reader = path->Os.OpenFile
      let lines = GrepFile(needle, reader)
      lines.begin@file.next.case {
        .end try! => {}
        .item((number) content) => {
          console.print("")
          console.print(`${path.absolute->String.FromBytes}:#{number}`)
          console.print(content)
          lines.loop@file
        }
      }
      paths.loop
    }
  }

  exit!
}

dec TraverseDirectory : [Os.Path] Try<Os.Error, List<Os.Path>>
def TraverseDirectory = [dirPath]
  catch e => .err e in
  let try tree = Os.TraverseDir(dirPath) in
  .ok tree.begin.case {
    .end! => .end!,
    .file(path) rest => .item(path) rest.loop,
    .dir(_, nested) rest => List.Concat(*(nested.loop, rest.loop)),
  }

dec GrepFile : [String, Os.Reader] Stream<Os.Error, (Nat) String>
def GrepFile = [needle, reader]
  String.ParseReader(reader)
    ->String.Lines
    ->Stream.Enumerate
    ->Stream.Map(box [(n) line] (n + 1) line)
    ->Stream.Filter(box [(_) line] Contains(needle, line))

// ---

dec Contains : [String, String] Bool
def Contains = [needle, haystack]
  String.Find(haystack, .str needle) is .some _
