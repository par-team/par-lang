module MiniGrep

import {
  @core/Bool
  @core/List
  @core/Nat
  @core/Try
  @core/String
  @basic/Console
  @basic/Os
}

def Main: ! = chan exit {
  let console = Console.Open

  catch ! => {
    console.print("Failed to read input.")
    console.close
    exit!
  }

  console.print("Welcome to Mini Grep!")
  console.prompt("Directory: ")[try path]
  console.prompt("Needle: ")[try needle]

  catch e => {
    console.print(e)
    console.close
    exit!
  }

  let try paths = path->Os.Path->TraverseDirectory
  paths.begin.case {
    .end! => {}
    .item(path) => {
      catch e => {
        console.print("")
        console.print(e)
        paths.loop
      }
      let try reader = path->Os.OpenFile
      let lines = GrepFile(needle, reader)
      lines.begin@file.next.case {
        .end try! => {}
        .item((number) content) => {
          console.print("")
          console.print(`${path.absolute->String.FromBytes}:#{number}`)
          console.print(content)
          lines.loop@file
        }
      }
      paths.loop
    }
  }

  console.close
  exit!
}

dec TraverseDirectory : [Os.Path] Try<Os.Error, List<Os.Path>>
def TraverseDirectory = [dirPath]
  catch e => .err e in
  let try tree = Os.TraverseDir(dirPath) in
  .ok tree.begin.case {
    .end! => .end!,
    .file(path) rest => .item(path) rest.loop,
    .dir(_, nested) rest => List.Concat(*(nested.loop, rest.loop)),
  }

dec GrepFile : [String, Os.Reader] Iterator<Os.Error, (Nat) String>
def GrepFile = [needle, reader]
  String.ParseReader(reader)
    ->Lines
    ->Enumerate1
    ->Filter(box [(_) line] Contains(needle, line))

// ---

dec Contains : [String, String] Bool
def Contains = [needle, haystack]
  String.Find(haystack, .str needle) is .some _

// ---

type Iterator<e, a> = recursive choice {
  .close => Try<e, !>,
  .next => either {
    .end Try<e, !>,
    .item(a) self,
  }
}

dec Lines : [<e> String.Parser<e>] Iterator<e, String>
def Lines = [<e> parser] do { parser.begin } in case {
  .close => parser.case {
    .empty! => .ok!,
    .ready parser => parser.close,
  },

  .next => parser.case {
    .empty! => .end.ok!,
    .ready parser => parser.minMax(.repeat.one.any!, .str "\n").case {
      .err e => .end.err e,
      .ok result => result.case {
        .fail parser => String.Remainder(.ready parser).case {
          .err e => .end.err e,
          .ok line => .item(line) case {
            .close => .ok!,
            .next => .end.ok!,
          },
        },
        .match(line, _) parser => .item(line) parser.loop,
      },
    },
  }
}

dec Filter : [<e, a> Iterator<e, box a>, box [a] Bool] Iterator<e, a>
def Filter = [<e, a> iter, predicate] do { iter.begin } in case {
  .close => iter.close,
  .next => iter.next.case {
    .end result => .end result,
    .item(value) iter => predicate(value).case {
      .true! => .item(value) iter.loop,
      .false! => iter.begin@skip.next.case {
        .end result => .end result,
        .item(value) iter => predicate(value).case {
          .true! => .item(value) iter.loop,
          .false! => iter.loop@skip,
        }
      },
    }
  }
}

dec Enumerate1 : [<e, a> Iterator<e, a>] Iterator<e, (Nat) a>
def Enumerate1 = [<e, a> iter] do {
  let index = 1
  iter.begin
} in case {
  .close => iter.close,
  .next => iter.next.case {
    .end result => .end result,
    .item(value) iter => .item((index) value) do {
      index += 1
    } in iter.loop
  }
}
