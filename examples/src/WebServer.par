module WebServer

import {
  @core/Bytes
  @core/List
  @core/Try
  @core/String
  @core/Url
  @basic/Console
  @core/Debug
  @basic/Http
  @basic/Os
}

def Main: ! = chan exit {
  let console = Console.Open
  catch e => {
    console.print(e)
    exit!
  }

  catch@prompt ! => { exit! }
  console.prompt("Directory to serve: ")[try@prompt root]

  let url = "127.0.0.1:8080"
  console.print(`Listening on ${url}...`)

  Http.Listen(url).begin.case {
    .shutdown try! => {
      console.print("Shutting down...")
      exit!
    }

    .incoming(request, respond) next => {
      let (method, url, headers) body = request
      ServePath(Os.Path(root), `${root}${url.path}`, respond)
      next.loop
    }
  }
}

dec ServePath : [Os.Path, String, [Http.Response] Try<Http.Error, !>] !
def ServePath = [root, path, respond] path->Os.Path->Os.ListDir.case {
  .err _ => ServeFile(path, respond),
  .ok paths => ServeDir(root, paths, respond),
}

dec ServeFile : [String, [Http.Response] Try<Http.Error, !>] !
def ServeFile = [path, respond] chan finish {
  catch e => { Debug.Log(e); finish! }
  catch e => {
    respond((404, *()) Bytes.Reader(e)).try
    finish!
  }

  let try file = path->Os.Path->Os.OpenFile
  respond((200, *(("Content-Type") "text/plain")) file)

  finish!
}

dec ServeDir : [Os.Path, List<Os.Path>, [Http.Response] Try<Http.Error, !>] !
def ServeDir = [root, paths, respond] chan finish {
  let content = Bytes.PipeReader([w] catch ! => .ok! in do {
    w.write("<ul>").try

    paths.begin.case {
      .end! => {}
      .item(path) => {
        w.write("<li>").try
        w.write("<a href=\"").try
        w.write(path.absolute->Bytes.TrimLeft(.bytes root.absolute)).try
        w.write("\">").try
        w.write(path.name).try
        w.write("</a>").try
        w.write("</li>").try
        paths.loop
      }
    }

    w.write("</ul>").try
    w.close.try
  } in .ok!)

  respond((200, *(("Content-Type") "text/html")) content)
  finish!
}
