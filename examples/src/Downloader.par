module Downloader

import {
  @core/BoxMap
  @core/Bytes
  @core/Int
  @core/List
  @core/Map
  @core/Nat
  @core/Option
  @core/Time
  @core/Try
  @core/String
  @core/Url
  @core/Debug
  @basic/Http
  @basic/Os
}

type Event = (Os.Path) either {  // destination
  .started Nat,                  // expected size
  .progressed Nat,               // chunk size
  .failed String,                // error message
  .finished!,
}

def Main =
  let rootPath = Os.Path(".").append("Downloads") in
  YieldDownloadRequests("127.0.0.1:3000", rootPath)  // : List<(Url, Os.Path)!>
    ->List.Map(box DownloadFile)                     // : List<List<Event>>
    ->List.Merge                                     // : List<Event>
    ->ShowDownloadProgress(rootPath)                 // : !

dec YieldDownloadRequests : [String, Os.Path] List<(Url, Os.Path)!>
def YieldDownloadRequests = [listenUrl, rootPath] chan yield {
  Debug.Log(`Listening on ${listenUrl}...`)
  catch e => {
    Debug.Log(`Listening error: ${e}`)
    yield.end!
  }

  Http.Listen(listenUrl).begin.case {
    .shutdown try! => {
      Debug.Log("Shutting down...")
      yield.end!
    }

    .incoming(request, respond) next => {
      let (method, url, headers) body = request
      catch e => {
        respond.http((400, *()) Bytes.Reader(e))
        next.loop
      }

      if method == "POST" => {
        let try sourceUrl = body
          ->String.ReadAll
          ->Try.FlatMap(box Url.FromString)

        let destination = rootPath.append(url.path->Bytes.TrimLeft(.bytes "/"))
        yield.item((sourceUrl, destination)!)
        respond.http((200, *()) Bytes.EmptyReader)
        next.loop
      }

      throw "Wrong method"
    }
  }
}

dec DownloadFile : [(Url, Os.Path)!] List<Event>
def DownloadFile = [(sourceUrl, dest)!] chan yield {
  catch err => {
    yield.item((dest) .failed err)
    yield.end!
  }

  let try (status, headers) body = Http.Fetch(("GET", sourceUrl, *()) Bytes.EmptyReader)
  let headers = BoxMap.FromList(headers)

  if status != 200 => {
    throw "Bad server response"
  }

  let try file = Os.CreateNewFile(dest)
  let default(0) totalSize =
    headers.get("content-length")
      ->Option.Map(box String.FromBytes)
      ->Option.FlatMap(box Nat.FromString)
  yield.item((dest) .started totalSize)

  let bytesSinceLastEvent = 0
  let timeOfLastEvent = Time.Now

  body.begin.read.try.case {
    .chunk(bytes) => {
      file.write(bytes).try

      bytesSinceLastEvent += Bytes.Length(bytes)
      if Time.Now->Time.Since(timeOfLastEvent) >= 100 * Time.Millisecond => {
        yield.item((dest) .progressed bytesSinceLastEvent)
        let bytesSinceLastEvent = 0
        let timeOfLastEvent = Time.Now
      }

      body.loop
    }
    .end! => {}
  }

  yield.item((dest) .progressed bytesSinceLastEvent)

  file.close.try
  yield.item((dest) .finished!)
  yield.end!
}

dec ShowDownloadProgress : [List<Event>, Os.Path] !
def ShowDownloadProgress = [events, rootPath] chan exit {
  let getName = box [path: Os.Path]
    path.absolute
      ->Bytes.TrimLeft(.bytes rootPath.absolute)
      ->String.FromBytes

  catch e => {
    Debug.Log(`Stdout error: ${e}`)
    exit!
  }

  let stdout = Os.Stdout
  let tracker = NewProgressTracker

  events.begin.case {
    .item((destination) event) => {
      let name = getName(destination)

      event.case {
        .started expected => {
          tracker.file(name).started(expected)
          stdout.write(`\nStarted downloading ${name}\n`).try
        }

        .progressed size => {
          tracker.file(name).progressed(size)
          tracker.stats[numFiles, sumDownloaded, sumExpected]
          stdout.write(`\r>> #{numFiles} file(s) in progress: #{sumDownloaded} B / #{sumExpected} B`).try
        }

        .finished! => {
          tracker.file(name).ended[startTime, downloadedSize]
          let duration = Time.Now->Time.Since(startTime)
          let speed = downloadedSize * Time.Second / duration
          stdout.write(String.Concat(*(
            `\nFinished downloading ${name}\n`,
            `    Size:  #{downloadedSize} B\n`,
            `    Time:  ${Time.Show(duration)}\n`,
            `    Speed: #{speed} B/s\n`
          ))).try
        }

        .failed msg => {
          tracker.file(name).ended[_, _]
          stdout.write(`\nFailed to download ${name}: ${msg}\n`).try
        }
      }
      stdout.flush.try
      events.loop
    }
    .end! => {}
  }

  exit!
}

type ProgressTracker = iterative choice {
  .close* => !,
  .stats => (Nat, Int, Int) self,
  .file(String) => choice {
    .started(Nat) => self,
    .ended => (Time.Instant, Nat) self,
    .progressed(Nat) => self,
  }
}

def NewProgressTracker: ProgressTracker = do {
  let filesInProgress = Map.New(type String, type (Time.Instant, Nat, Nat)!)
  let sumDownloaded: Int = 0
  let sumExpected: Int = 0
} in begin case {
  .close* => !,

  .stats => do {
    filesInProgress.size[numFiles]
  } in (numFiles, sumDownloaded, sumExpected) loop,

  .file(name) => do {
    filesInProgress.entry(name)[entry]
    if not entry is .some(startTime, expected, downloaded)! => {
      let startTime = Time.Now
      let expected = 0
      let downloaded = 0
    }
  } in case {
    .started(newExpected) => do {
      filesInProgress.put((startTime, newExpected, downloaded)!)
      sumExpected -= expected
      sumExpected += newExpected
    } in loop,

    .ended => do {
      filesInProgress.delete
      sumExpected -= expected
      sumDownloaded -= downloaded
    } in (startTime, downloaded) loop,

    .progressed(size) => do {
      filesInProgress.put((startTime, expected, downloaded + size)!)
      sumDownloaded += size
    } in loop,
  }
}
