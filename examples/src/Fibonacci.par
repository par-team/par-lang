module Fibonacci

import {
  @core/Nat
  @basic/Console
}

type Sequence<a> = iterative choice {
  .close* => !
  .next  => (a) self
}

dec Fibonacci : Sequence<Nat>
def Fibonacci =
  let (a) b = (0) 1
  in begin case {
    .close* => !
    .next =>
      let next = a + b in
      let (a) b = (b) next
      in (a) loop
  }

def Main: ! = do {
  let console = Console.Open
  let fib = Fibonacci

  Nat.Repeat(30).begin.case {
    .end! => {}
    .step remaining => {
      fib.next[n]
      console.print(`#{n}`)
      remaining.loop
    }
  }

  fib.close
  console.close
} in !
