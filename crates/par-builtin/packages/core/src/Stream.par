// Finite pull-based streams with fallible production and infallible close.
//
// Consumers request one item at a time with `.next`. A requested step can
// either produce an item, finish successfully, or finish with an error. Consumers may
// stop early with `.close`, allowing the producer to release its resources.
export module Stream

import {
  Bool
  List
  Nat
  Number
  Try
}

export {
  // A finite pull-based sequence of values of type `a` whose production can
  // fail with an error of type `e`.
  //
  // Operations:
  // - `.close` abandons the stream and releases its resources.
  // - `.next` requests the next step. It returns `.item(value) stream` when an
  //   item is available, `.end.ok!` on normal completion, or `.end.err e` when
  //   production fails.
  type Stream<e, a> = recursive choice {
    .close* => !,
    .next => either {
      .end Try<e, !>,
      .item(a) self,
    },
  }

  // Collects the stream into a list. If the stream fails, the list is discarded and the error is returned.
  dec ToList : [<e, a: drop> Stream<e, a>] Try<e, List<a>>

  // Collects the stream into a list. If the stream fails, the items collected so far are returned along with the error.
  dec Collect : [<e, a> Stream<e, a>] (Try<e, !>) List<a>

  // Creates an infallible stream from a list.
  dec FromList : [<a: drop> List<a>] Stream<either {}, a>

  // Applies a mapping function to each item of a stream.
  dec Map : [<e, a> Stream<e, a>, <b> box [a] b] Stream<e, b>

  // Pairs each item with its zero-based index.
  dec Enumerate : [<e, a> Stream<e, a>] Stream<e, (Nat) a>

  // Applies a mapping function to the stream's error type.
  dec MapErr : [<e1, a> Stream<e1, a>, <e2> box [e1] e2] Stream<e2, a>

  // Maps each item to a stream, then flattens the result.
  dec FlatMap : [<e, a> Stream<e, a>, <b> box [a] Stream<e, b>] Stream<e, b>

  // Flattens a stream of streams into a single stream.
  dec Flatten : [<e, a> Stream<e, Stream<e, a>>] Stream<e, a>

  // Concatenates a list of streams into a single stream.
  dec Concat : [<e, a> List<Stream<e, a>>] Stream<e, a>

  // Keeps the items for which the test function returns `.true!`.
  dec Filter : [<e, a: share> Stream<e, a>, box [a] Bool] Stream<e, a>

  // Yields at most the requested number of items, closing the source when
  // enough items have been taken.
  dec Take : [<e, a> Stream<e, a>, Nat] Stream<e, a>

  // Skips the requested number of items and yields the rest.
  dec Drop : [<e, a: drop> Stream<e, a>, Nat] Stream<e, a>

  // Yields items while the test function returns `.true!`, then closes the source.
  dec TakeWhile : [<e, a: share> Stream<e, a>, box [a] Bool] Stream<e, a>

  // Skips items while the test function returns `.true!`, then yields the rest.
  dec DropWhile : [<e, a: share> Stream<e, a>, box [a] Bool] Stream<e, a>

  // Folds over the stream. The returned pair contains the stream completion
  // status and the final accumulator.
  dec ForEach : [<r> r, <e, a> Stream<e, a>, box [r, a] r] (Try<e, !>) r

  // Returns `.ok.true!` if the test function holds for every item.
  // Short-circuits and closes the source on the first `.false!`.
  dec All : [<e, a> Stream<e, a>, box [a] Bool] Try<e, Bool>

  // Returns `.ok.true!` if the test function holds for at least one item.
  // Short-circuits and closes the source on the first `.true!`.
  dec Any : [<e, a> Stream<e, a>, box [a] Bool] Try<e, Bool>

  // Calculates the sum of all stream items.
  dec Sum : [<e, a: number> Stream<e, a>] Try<e, a>
}

def ToList = [<e, a: drop> stream]
  let builder = List.Builder(type a) in
  stream.begin.next.case {
    .end result => result.case {
      .ok! => .ok builder.build,
      .err e => let _ = builder.build in .err e,
    },
    .item(value) stream => do {
      builder.add(value)
    } in stream.loop,
  }

def Collect = [<e, a> stream]
  stream.begin.next.case {
    .end result => result.case {
      .ok! => (.ok!) .end!,
      .err e => (.err e) .end!,
    }
    .item(value) stream => do {
      let (result) list = stream.loop
    } in (result) .item(value) list,
  }

def FromList = [<a: drop> list] list.begin.case {
  .end! => case {
    .close* => !,
    .next => .end.ok!,
  },
  .item(value) list => case {
    .close* => !,
    .next => .item(value) list.loop,
  },
}

def Map = [<e, a> stream, <b> f] do {
  stream.begin
} in case {
  .close* => stream.close,
  .next => stream.next.case {
    .end result => .end result,
    .item(value) stream => .item(f(value)) stream.loop,
  },
}

def Enumerate = [<e, a> stream]
  let index = 0 in
  do { stream.begin } in case {
    .close* => stream.close,
    .next => stream.next.case {
      .end result => .end result,
      .item(value) stream => do {
        let current = index
        index += 1
      } in .item((current) value) stream.loop,
    },
  }

def MapErr = [<e1, a> stream, <e2> f] do {
  stream.begin
} in case {
  .close* => stream.close,
  .next => stream.next.case {
    .end result => .end result->Try.MapErr(f),
    .item(value) stream => .item(value) stream.loop,
  },
}

def FlatMap = [<e, a> stream, <b> f] stream->Map(f)->Flatten

def Flatten = [<e, a> streams] case {
  .close* => do {
    streams.begin
    streams.close
  } in !,

  .next => streams.begin@outer.next.case {
    .end result => .end result,
    .item(stream) streams => stream.begin@inner.next.case {
      .end result => result.case {
        .ok! => streams.loop@outer,
        .err e => do {
          streams.begin
          streams.close
        } in .end.err e,
      },
      .item(value) stream => .item(value) case {
        .close* => do {
          stream.begin
          stream.close
          streams.begin
          streams.close
        } in !,
        .next => stream.loop@inner,
      },
    },
  },
}

def Concat = [<e, a> streams] streams->FromList->Flatten

def Filter = [<e, a: share> stream, predicate] do {
  stream.begin
} in case {
  .close* => stream.close,
  .next => stream.next.case {
    .end result => .end result,
    .item(value) stream => predicate(value).case {
      .true! => .item(value) stream.loop,
      .false! => stream.begin@skip.next.case {
        .end result => .end result,
        .item(value) stream => predicate(value).case {
          .true! => .item(value) stream.loop,
          .false! => stream.loop@skip,
        },
      },
    },
  },
}

def Take = [<e, a> stream, n]
  Nat.Repeat(n).begin@take.case {
    .end! => case {
      .close* => do {
        stream.begin
        stream.close
      } in !,
      .next => do {
        stream.begin
        stream.close
      } in .end.ok!,
    },
    .step steps => do {
      stream.begin
    } in case {
      .close* => stream.close,
      .next => stream.next.case {
        .end result => .end result,
        .item(value) stream => .item(value) steps.loop@take,
      },
    },
  }

def Drop = [<e, a: drop> stream, n] case {
  .close* => do {
    stream.begin
    stream.close
  } in !,
  .next => Nat.Repeat(n).begin@drop.case {
    .end! => do {
      stream.begin
    } in stream.next,
    .step steps => do {
      stream.begin
    } in stream.next.case {
      .end result => .end result,
      .item(_) stream => steps.loop@drop,
    },
  },
}

def TakeWhile = [<e, a: share> stream, predicate] do {
  stream.begin
} in case {
  .close* => stream.close,
  .next => stream.next.case {
    .end result => .end result,
    .item(value) stream => predicate(value).case {
      .true! => .item(value) stream.loop,
      .false! => do {
        stream.begin
        stream.close
      } in .end.ok!,
    },
  },
}

def DropWhile = [<e, a: share> stream, predicate] case {
  .close* => do {
    stream.begin
    stream.close
  } in !,
  .next => stream.begin@drop.next.case {
    .end result => .end result,
    .item(value) stream => predicate(value).case {
      .true! => stream.loop@drop,
      .false! => .item(value) stream,
    },
  },
}

def ForEach = [<r> result, <e, a> stream, f]
  stream.begin.next.case {
    .end status => (status) result,
    .item(value) stream => do {
      let result = f(result, value)
    } in stream.loop,
  }

def All = [<e, a> stream, predicate] stream.begin.next.case {
  .end result => result.case {
    .ok! => .ok.true!,
    .err e => .err e,
  },
  .item(value) stream => predicate(value).case {
    .true! => stream.loop,
    .false! => do {
      stream.begin
      stream.close
    } in .ok.false!,
  },
}

def Any = [<e, a> stream, predicate] stream.begin.next.case {
  .end result => result.case {
    .ok! => .ok.false!,
    .err e => .err e,
  },
  .item(value) stream => predicate(value).case {
    .true! => do {
      stream.begin
      stream.close
    } in .ok.true!,
    .false! => stream.loop,
  },
}

def Sum = [<e, a: number> stream] do {
  let sum = Number.Zero(type a)
} in stream.begin.next.case {
  .end result => result.case {
    .ok! => .ok sum,
    .err e => .err e,
  },
  .item(value) stream => do {
    sum += value
  } in stream.loop,
}
